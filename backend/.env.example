# ==============================================================================
# Ethio Tech Market - Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and fill in your actual credentials.
# NEVER commit your real `.env` file containing secrets to version control.

# Django Core Security & Runtime
SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Relational Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ai_online_selling_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Production Database URL (Used by Render / Railway / Cloud PostgreSQL)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# Chapa Payment Gateway (Official Ethiopian Payment Switch)
# Register at https://chapa.co to obtain your sandbox / live API keys
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_API_URL=https://api.chapa.co/v1

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Seed Administrator & Store Manager Demo Credentials
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=admin_secure_password_here
STORE_MANAGER_EMAIL=manager@store.com
STORE_MANAGER_PASSWORD=manager_secure_password_here

# ==============================================================================
# Google OAuth 2.0 / OpenID Connect Configuration
# ==============================================================================
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Configure OAuth consent screen with app name 'Ethio Tech Market'
# 3. Create OAuth 2.0 Client ID for Web Application
# 4. Add Authorized JavaScript origins: http://localhost:5173, https://your-domain.com
# 5. Add Authorized redirect URIs: http://localhost:5173/login
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# SMTP Email Delivery Configuration (Password Reset & Verification)
# ==============================================================================
# For local dev without an SMTP server, Django falls back to console backend:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production (Gmail, SendGrid, Amazon SES, Brevo):
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password_here
DEFAULT_FROM_EMAIL=Ethio Tech Market <noreply@ethiotechmarket.com>

